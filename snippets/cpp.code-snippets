      "// 時空間BFS: (時刻t, 位置v)を別状態として保持する。状態数=(T+1)*N。",
      "// 障害物が時刻で変化する場合・待機が必要な場合に利用する。",
      "struct TimeSpaceBFS {",
      "    int positions,max_time;",
      "    StampedBFS bfs;",
      "    TimeSpaceBFS(int num_positions,int final_time)",
      "        :positions(num_positions),max_time(final_time),",
