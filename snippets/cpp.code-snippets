      "        if (static_cast<std::size_t>(n) >= factorial.size()) throw std::out_of_range(\"n\");",
      "        return static_cast<int>(static_cast<__int128>(factorial[n])*inverse_factorial[k] % modulus * inverse_factorial[n-k] % modulus);",
      "    \\}",
