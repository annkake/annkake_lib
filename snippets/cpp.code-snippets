      "              <<\"] width=\"<<width[i]<<\" shift=\"<<shift[i]",
      "              <<\" mask=0x\"<<hex<<mask[i]<<dec<<'\\\\n';",
      "    \\}",
      "\\};",
      "\\} // namespace ahc",
