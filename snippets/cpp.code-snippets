      "/**",
      " * @file dsu.hpp",
      " * @brief 経路圧縮とサイズによる併合を使う素集合データ構造。",
      " * @details 0始まり。n >= 0。root/same/sizeは償却 O(alpha(n))。全uniteのリスト移動はO(n log n)、空間 O(n)。頂点は範囲内。",
      " * @pre コンテナのサイズ・添字と戻り値はintで表現可能なこと。個別条件は各APIを参照。",
      " * @note SPDX-License-Identifier: CC0-1.0",
      " * @see ../../docs/licensing.md 旧実装の出典調査と今回の置き換え範囲。",
      " * @par 使用例: 代表頂点と同じ成分の頂点を参照する",
      " * @code{.cpp\\}",
      " * DSU dsu(5);",
      " * dsu.unite(0, 2);",
      " * dsu.unite(2, 4);",
      " * int leader = dsu.root(4);",
      " * const auto& group = dsu.members(leader); // 頂点0,2,4を含む。順序は保証しない。",
      " * for (int v : group) { (void)v; \\} // 成分内の頂点に対する処理",
      " * bool connected = dsu.same(0, 4); // true",
      " * int size = dsu.size(2);          // 3",
      " * (void)connected; (void)size;",
      " * @endcode",
      " */",
      "class DSU {",
      "    std::vector<int> link;",
      "    std::vector<std::vector<int>> component;",
      "public:",
      "    explicit DSU(int n) {",
      "        if (n < 0) throw std::invalid_argument(\"negative size\");",
      "        link.assign(n, -1);",
      "        component.resize(n);",
      "        for (int v = 0; v < n; ++v) component[v].push_back(v);",
      "    \\}",
      "    int root(int v) {",
      "        int r = v;",
      "        while (link[r] >= 0) r = link[r];",
      "        while (v != r) { int next = link[v]; link[v] = r; v = next; \\}",
      "        return r;",
      "    \\}",
      "    bool same(int a, int b) { return root(a) == root(b); \\}",
      "    /// @return 異なる集合を併合したときtrue。",
      "    bool unite(int a, int b) {",
      "        a = root(a); b = root(b);",
      "        if (a == b) return false;",
      "        if (link[a] > link[b]) std::swap(a, b);",
      "        // small-to-large: 各頂点が移動する回数はO(log n)。",
      "        component[a].insert(component[a].end(), component[b].begin(), component[b].end());",
      "        std::vector<int>().swap(component[b]); // 敗者側の容量も解放し、全体O(n)空間を保つ。",
      "        link[a] += link[b]; link[b] = a;",
      "        return true;",
      "    \\}",
      "    /// @return vと同じ成分の頂点列への読み取り専用参照。代表頂点以外からも呼べる。",
      "    /// @warning unite後は順序・参照・イテレータを保存し続けず、再取得すること。",
      "    const std::vector<int>& members(int v) { return component[root(v)]; \\}",
      "    int size(int v) { return -link[root(v)]; \\}",
      "\\};"
    ],
    "description": "経路圧縮とサイズによる併合を使う素集合データ構造。"
  },
  "euler_tour": {
    "scope": "cpp",
    "prefix": "euler_tour",
    "body": [
      "/**",
      " * @file euler_tour.hpp",
      " * @brief 木のDFS訪問順・オイラー巡回順と部分木の半開区間。",
      " * @details 0始まりの連結な無向木。構築O(n)時間・空間。再帰を使わない。",
      " * @note SPDX-License-Identifier: CC0-1.0",
      " * @par 使用例: 部分木を配列上の区間にする",
      " * @code{.cpp\\}",
      " * std::vector<std::vector<int>> tree{{1,2\\}, {0,3\\}, {0\\}, {1\\}\\};",
      " * EulerTour et(tree, 0);",
      " * // et.order = {0,1,3,2\\}、et.tour = {0,1,3,1,0,2,0\\}。",
      " * int left = et.tin[1], right = et.tout[1]; // [1,3)が頂点1の部分木。",
      " * for (int i = left; i < right; ++i) {",
      " *     int v = et.order[i]; // 頂点1,3。この順に処理する。",
      " *     (void)v;",
      " * \\}",
      " * // BITやセグ木にはflat[et.tin[v]] = value[v]と並べ、[left,right)を問い合わせる。",
      " * @endcode",
      " */",
      "class EulerTour {",
      "public:",
      "    /// @brief 各頂点を一度だけ記録した行きがけ順。部分木vはorder[tin[v],tout[v])。",
      "    std::vector<int> order, tin, tout;",
      "    /// @brief 親への戻りも含む巡回順（2*n-1要素）。first[v]はtour内の最初の位置。",
      "    /// @warning tin/toutはtourではなくorderに対する添字。",
      "    std::vector<int> tour, first, parent, depth;",
      "    explicit EulerTour(const std::vector<std::vector<int>>& tree, int root = 0) {",
      "        int n = static_cast<int>(tree.size());",
      "        if (n == 0 && root == 0) return;",
      "        if (root < 0 || root >= n) throw std::out_of_range(\"root\");",
      "        tin.assign(n,-1); tout.assign(n,-1); first.assign(n,-1);",
      "        parent.assign(n,-1); depth.assign(n,0);",
      "        std::vector<std::pair<int,std::size_t>> stack;",
      "        auto enter = [&](int v) {",
      "            tin[v] = static_cast<int>(order.size()); order.push_back(v);",
      "            first[v] = static_cast<int>(tour.size()); tour.push_back(v);",
      "            stack.emplace_back(v,0);",
      "        \\};",
      "        enter(root);",
      "        while (!stack.empty()) {",
      "            int v = stack.back().first;",
      "            auto& next = stack.back().second;",
      "            if (next == tree[v].size()) {",
      "                tout[v] = static_cast<int>(order.size()); stack.pop_back();",
      "                if (!stack.empty()) tour.push_back(stack.back().first);",
      "                continue;",
      "            \\}",
      "            int to = tree[v][next++];",
      "            if (to < 0 || to >= n) throw std::out_of_range(\"vertex\");",
      "            if (to == parent[v]) continue;",
      "            if (tin[to] != -1) throw std::invalid_argument(\"not a tree\");",
      "            parent[to] = v; depth[to] = depth[v]+1; enter(to);",
      "        \\}",
      "        if (order.size() != tree.size()) throw std::invalid_argument(\"disconnected tree\");",
      "    \\}",
      "\\};"
    ],
    "description": "木のDFS訪問順・オイラー巡回順と部分木の半開区間。"
  },
