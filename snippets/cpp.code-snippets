      "            if(positions<=0||max_time<0||int64_t(positions)*(int64_t(max_time)+1)>INT_MAX)",
      "                throw invalid_argument(\"時空間BFSのサイズが不正\");",
      "            return positions*(max_time+1);",
      "         \\}()){\\}",
