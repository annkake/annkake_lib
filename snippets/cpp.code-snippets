    "body": [
      "/**",
      " * @file rolling_hash.hpp",
      " * @brief 2つの法を使う文字列のローリングハッシュ。",
      " * @details 構築O(n)、getはO(1)。半開区間[l,r)。衝突があり得るため一致は同一文字列の保証ではない。",
      " * @pre コンテナのサイズ・添字と戻り値はintで表現可能なこと。個別条件は各APIを参照。",
      " * @note SPDX-License-Identifier: CC0-1.0",
      " * @see ../../docs/licensing.md 旧実装の出典調査と今回の置き換え範囲。",
      " * @par 使用例: 部分文字列のハッシュを比較する",
      " * @code{.cpp\\}",
      " * RollingHash hash(\"abracadabra\");",
      " * bool equal = hash.get(0,4) == hash.get(7,11); // 両方\"abra\"なのでtrue。",
      " * (void)equal;",
      " * // 一般にハッシュ一致だけでは衝突の可能性を排除できない。",
      " * @endcode",
      " */",
      "class RollingHash {",
      "    static constexpr std::array<std::uint64_t,2> mod{1000000007,1000000009\\};",
      "    static constexpr std::uint64_t base = 911382323;",
      "    std::array<std::vector<std::uint64_t>,2> prefix, power;",
      "public:",
      "    explicit RollingHash(const std::string& text) {",
      "        for (std::size_t k=0; k<2; ++k) {",
      "            prefix[k].assign(text.size()+1,0); power[k].assign(text.size()+1,1);",
      "            for (std::size_t i=0; i<text.size(); ++i) {",
      "                std::uint64_t code = static_cast<unsigned char>(text[i])+1;",
      "                prefix[k][i+1] = (prefix[k][i]*base+code)%mod[k];",
      "                power[k][i+1] = power[k][i]*base%mod[k];",
      "            \\}",
      "        \\}",
      "    \\}",
      "    /// @return 2つの法でのハッシュ値。空区間は{0,0\\}。",
      "    std::pair<int,int> get(int left, int right) const {",
      "        if (left < 0 || left > right || static_cast<std::size_t>(right) >= prefix[0].size()) throw std::out_of_range(\"interval\");",
      "        std::array<int,2> value{\\};",
      "        for (std::size_t k=0; k<2; ++k)",
      "            value[k] = static_cast<int>((prefix[k][right]+mod[k]-prefix[k][left]*power[k][right-left]%mod[k])%mod[k]);",
      "        return {value[0],value[1]\\};",
      "    \\}",
      "\\};"
    ],
    "description": "2つの法を使う文字列のローリングハッシュ。"
  },
  "trie": {
    "scope": "cpp",
    "prefix": [
      "trie",
      "Trie"
    ],
    "body": [
      "/**",
      " * @file trie.hpp",
      " * @brief 小文字英字のTrieと共有接頭辞長の検索。",
      " * @details insert/lcp/countはO(文字数)。文字列はa-zのみ。重複・空文字列にも対応。",
      " * @pre コンテナのサイズ・添字と戻り値はintで表現可能なこと。個別条件は各APIを参照。",
      " * @note SPDX-License-Identifier: CC0-1.0",
      " * @see ../../docs/licensing.md 旧実装の出典調査と今回の置き換え範囲。",
      " * @par 使用例: 登録文字列と共通する接頭辞を調べる",
      " * @code{.cpp\\}",
      " * Trie trie;",
      " * trie.insert(\"apple\"); trie.insert(\"apply\");",
      " * int lcp = trie.lcp(\"apple\",2); // 4。自分以外の登録文字列との最大LCP。",
      " * int count = trie.count(\"apple\"); // 1",
      " * int prefix = trie.lcp(\"apt\"); // 2。未登録の文字列でも検索できる。",
      " * (void)lcp; (void)count; (void)prefix;",
      " * @endcode",
      " */",
      "class Trie {",
      "    struct Node {",
      "        std::array<int,26> child;",
      "        int pass = 0, terminal = 0;",
      "        Node() { child.fill(-1); \\}",
      "    \\};",
      "    std::vector<Node> nodes{Node{\\}\\};",
      "    static void validate(const std::string& word) {",
      "        for (char c : word) if (c < 'a' || c > 'z') throw std::invalid_argument(\"lowercase word required\");",
      "    \\}",
      "public:",
      "    void insert(const std::string& word) {",
      "        validate(word); int at = 0; ++nodes[at].pass;",
      "        for (char c : word) {",
      "            int slot = c-'a';",
      "            if (nodes[at].child[slot] < 0) {",
      "                int next = static_cast<int>(nodes.size());",
      "                nodes.emplace_back(); nodes[at].child[slot] = next;",
      "            \\}",
      "            at = nodes[at].child[slot]; ++nodes[at].pass;",
      "        \\}",
      "        ++nodes[at].terminal;",
      "    \\}",
      "    int count(const std::string& word) const {",
      "        validate(word); int at=0;",
      "        for (char c : word) { at = nodes[at].child[c-'a']; if (at < 0) return 0; \\}",
      "        return nodes[at].terminal;",
      "    \\}",
      "    /** @return prefixの通過数がmin_count以上となる最大接頭辞長。",
      "     * @param min_count 1なら登録済み文字列とのLCP。登録済みの自分以外と比較する場合は2。",
      "     */",
      "    int lcp(const std::string& word, int min_count = 1) const {",
      "        validate(word);",
      "        if (min_count < 1) throw std::invalid_argument(\"positive count required\");",
      "        int at=0, length=0;",
      "        for (char c : word) {",
      "            at = nodes[at].child[c-'a'];",
      "            if (at < 0 || nodes[at].pass < min_count) break;",
      "            ++length;",
      "        \\}",
      "        return length;",
      "    \\}",
      "\\};"
    ],
    "description": "小文字英字のTrieと共有接頭辞長の検索。"
  },
  "compress": {
