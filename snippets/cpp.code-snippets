      " * @par 使用例: 剰余べき乗を計算する",
      " * @code{.cpp\\}",
      " * int value = mod_pow(2,10,1000); // 24",
      " * int identity = mod_pow(7,0,13); // 1",
      " * (void)value; (void)identity;",
      " * @endcode",
      " */",
      "inline int mod_pow(int base, int exponent, int mod) {",
      "    if (exponent < 0 || mod < 1) throw std::invalid_argument(\"exponent or modulus\");",
